<h1>Edit task</h1>

<%= form_with model: @task do |f| %>
  <p>
    <%= f.label :title %><br>
    <%= f.text_field :title %>
  </p>

  <p>
    <%= f.label :details %><br>
    <%= f.text_area :details %>
  </p>

  <p>
    <%= f.check_box :completed %>
    <%= f.label :completed %>
  </p>

  <%= f.submit "Update task" %>
<% end %>
